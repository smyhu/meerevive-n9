--- /dev/null
+++ b/src/forumnetworkaccessmanager.h
@@ -0,0 +1,33 @@
+#ifndef FORUMNETWORKACCESSMANAGER_H
+#define FORUMNETWORKACCESSMANAGER_H
+
+#include <QNetworkAccessManager>
+#include <QNetworkRequest>
+#include <QDeclarativeNetworkAccessManagerFactory>
+
+// talk.maemo.org sits behind the Anubis anti-bot gate, which shows a JavaScript
+// proof-of-work page to every client whose User-Agent contains "Mozilla".
+// Qt 4 sends "Mozilla/5.0" when no User-Agent is set, so set our own on every request.
+#define FORUM_USER_AGENT "forum-qml/0.2.1 (Nokia N9; MeeGo Harmattan)"
+
+class ForumNetworkAccessManager : public QNetworkAccessManager
+{
+public:
+    explicit ForumNetworkAccessManager(QObject *parent = 0) : QNetworkAccessManager(parent) {}
+protected:
+    QNetworkReply *createRequest(Operation op, const QNetworkRequest &req, QIODevice *outgoingData = 0)
+    {
+        QNetworkRequest r(req);
+        r.setRawHeader("User-Agent", FORUM_USER_AGENT);
+        return QNetworkAccessManager::createRequest(op, r, outgoingData);
+    }
+};
+
+// Same User-Agent for images (avatars, smilies, attachments) loaded by QML
+class ForumNetworkAccessManagerFactory : public QDeclarativeNetworkAccessManagerFactory
+{
+public:
+    QNetworkAccessManager *create(QObject *parent) { return new ForumNetworkAccessManager(parent); }
+};
+
+#endif
