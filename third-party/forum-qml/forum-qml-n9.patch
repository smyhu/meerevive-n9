+// talk.maemo.org is HTTPS-only now, but vBulletin still writes absolute
+// http:// URLs into redirects and some links. Map them to the https base URL.
+static QUrl toBaseScheme(const QUrl& url, const QString& base)
+{
+    if (base.startsWith("https://")) {
+        const QString http = "http://" + base.mid(8);
+        const QString s = url.toString();
+        if (s.startsWith(http))
+            return QUrl(base + s.mid(http.length()));
+    }
+    return url;
+}
